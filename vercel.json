{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/talent?sitemap=1" },
    { "source": "/talent/:slug", "destination": "/api/talent?page=:slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/instagram-refresh", "schedule": "0 6 * * 1" }]
}
